{
  "name": "rescan_ia_train",
  "finetune_norm": false,
  "model": {
    "which_model": {
      "name": ["models.model", "ReScanIA"],
      "args": {
        "sample_num": 8,
        "task": "inpainting",
        "optimizers": [
          { "lr": 5e-5, "weight_decay": 0 }
        ]
      }
    },
    "which_networks": [
      {
        "name": ["models.network", "Network"],
        "args": {
          "unet": {
            "image_size": 96,
            "in_channel": 3,
            "inner_channel": 32,
            "out_channel": 1,
            "res_blocks": 2,
            "attn_res": [16],
            "channel_mults": [1, 2, 4, 8],
            "dropout": 0,
            "use_checkpoint": false,
            "use_fp16": false,
            "num_heads": 1,
            "num_head_channels": -1,
            "use_scale_shift_norm": false,
            "resblock_updown": true,
            "use_new_attention_order": false,
            "spade_seg_channel": 1
          },
          "beta_schedule": {
            "train": {
              "schedule": "linear",
              "n_timestep": 1000,
              "linear_start": 1e-6,
              "linear_end": 1e-2
            },
            "val": {
              "schedule": "linear",
              "n_timestep": 1000,
              "linear_start": 1e-6,
              "linear_end": 1e-2
            },
            "test": {
              "schedule": "linear",
              "n_timestep": 1000,
              "linear_start": 1e-6,
              "linear_end": 1e-2
            }
          },
          "module_name": "spade_diffusion_3d"
        }
      }
    ],
    "which_losses": [
      { "name": ["models.loss", "l1_loss"] }
    ],
    "which_metrics": [
      { "name": ["models.metric", "mae"] }
    ]
  },
  "datasets": {
    "train": {
      "which_dataset": {
        "name": ["data.dataset_spade_3d", "ReScanIATrainDataset"],
        "args": {
          "data_root": "PATH/TO/train/image",
          "aneurysm_root": "PATH/TO/train/aneurysm_mask",
          "vessel_root": "PATH/TO/train/vessel_mask",
          "data_len": -1,
          "normalization": "ct_normalize_simple",
          "hu_min": -50,
          "hu_max": 450,
          "image_size": [96, 96, 96],
          "mask_size_range": [10, 30]
        }
      },
      "dataloader": {
        "args": {
          "batch_size": 1,
          "shuffle": true,
          "num_workers": 0,
          "pin_memory": true,
          "drop_last": false
        },
        "validation_split": 0.02
      }
    }
  },
  "path": {
    "base_dir": "experiments",
    "code": "code",
    "tb_logger": "tb_logger",
    "results": "results",
    "checkpoint": "checkpoint",
    "resume_state": null
  },
  "train": {
    "n_epoch": 300,
    "n_iter": 1000000,
    "batch_size": 1,
    "log_iter": 100,
    "val_epoch": 1,
    "save_checkpoint_epoch": 1,
    "tensorboard": true
  },
  "distributed": false,
  "gpu_ids": [0],
  "seed": 42
}
